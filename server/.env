# ==============================================================================
# AttendanceX Backend Production Environment Configuration
# ==============================================================================

# Application Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Render/Railway/Fly will automatically override this if provided)
PORT=5000

# JSON Web Token Secret Key for institutional signing and token verification
JWT_SECRET=bd4bcaf71c6e9c13f40c0478a4eb102dc94116e352d7c02a4015812f70ba0343

# RFID Scanner Hardware Secret Key (Required for POST /api/attendance/rfid-mark)
# Passed in Authorization: Bearer <RFID_API_KEY> header by the physical scanner device
RFID_API_KEY=jDpTQolAiB8e4EfhTAWHu6OyTWMrdjgKrSIed4sgY3g

# Allowed CORS Origins (comma-separated list of trusted client origins, or '*' for open access)
# Examples: http://localhost:5173,https://attendancex.vercel.app
CORS_ORIGIN=*

# Demo Passwords Flag: Set to false to disable master bypass logins in network deployments
ALLOW_DEMO_PASSWORDS=false