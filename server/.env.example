# ==============================================================================
# AttendanceX Backend Environment Variables (.env.example)
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Application Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Render/Railway/Fly automatically assigns this in production)
PORT=5000

# JSON Web Token Secret Key (Generate a random 64-char hex key for production)
JWT_SECRET=your_super_secret_jwt_key_generate_with_crypto_in_production

# RFID Scanner Hardware Secret Key (Required for POST /api/attendance/rfid-mark)
# Physical device must send header: Authorization: Bearer <RFID_API_KEY>
RFID_API_KEY=your_hardware_rfid_secret_api_key_here

# Allowed CORS Origins (comma-separated list of domains, or '*' for open)
# Example: http://localhost:5173,https://your-frontend-app.vercel.app
CORS_ORIGIN=*

# Demo Master Password Bypass: Keep 'false' in production for secure logins
ALLOW_DEMO_PASSWORDS=false

# DNN Face Recognition Database Directory (relative or absolute path)
FACE_DB_PATH=face_db

# ==============================================================================
# SMTP Email Delivery Configuration (Feature 6: Email OTP Verification)
# Supports Gmail, Brevo, SendGrid, Amazon SES, Mailgun, Office365, or any SMTP
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_institutional_email@gmail.com
SMTP_PASS=your_app_specific_password_or_smtp_key
EMAIL_FROM=AttendanceX Security <your_institutional_email@gmail.com>
EMAIL_TEST_MODE=false

